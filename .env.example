# إعدادات Firebase لتفعيل لوحة الكاشير اللحظية بين الأجهزة.
# انسخ هذا الملف إلى .env واملأ القيم من: Firebase Console → Project settings → Your apps (Web).
# بدون هذه القيم يعمل الموقع بنظام محلي بديل (نفس الجهاز/المتصفح فقط).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
